{
  "name": "tetthys/wrap",
  "description": "Minimal Result-like wrapper with fluent map/filter/reduce and conditional helpers for PHP 8.3+.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Tetthys\\Wrap\\": "src/"
    }
  },
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "pestphp/pest": "^2.34"
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
